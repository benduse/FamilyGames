# Copy to .env (never commit .env)
PORT=4000
NODE_ENV=development

# Local:  postgres://postgres:postgres@localhost:5432/family_games
# Render: use the database's Internal URL when the API also runs on Render
DATABASE_URL=postgres://postgres:postgres@localhost:5432/family_games
# Set to true only when using Render's External URL from your laptop
DATABASE_SSL=false

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Where the React app runs (comma-separate several)
CLIENT_ORIGIN=http://localhost:5173

# Number of proxies in front of the API (Render = 1, Netlify proxy + Render = 2)
TRUST_PROXY=1
